<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShareLoc" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/skoda_emerald</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/skoda_electric</item>
        <item name="colorOnPrimaryContainer">@color/skoda_emerald</item>
        <item name="colorSecondary">@color/skoda_electric</item>
        <item name="colorOnSecondary">@color/skoda_emerald</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/skoda_dark_grey</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/skoda_emerald</item>
        <item name="android:navigationBarColor">@color/skoda_emerald</item>
        <item name="android:windowBackground">@color/skoda_light_grey</item>
    </style>

    <style name="ShareLoc.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="ShareLoc.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/skoda_electric</item>
        <item name="android:textColor">@color/skoda_emerald</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ShareLoc.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/skoda_emerald</item>
        <item name="android:textColor">@color/skoda_emerald</item>
    </style>
</resources>
