<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShareLoc" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/skoda_electric</item>
        <item name="colorOnPrimary">@color/skoda_emerald_deep</item>
        <item name="colorPrimaryContainer">@color/skoda_emerald_surface</item>
        <item name="colorOnPrimaryContainer">@color/skoda_on_dark</item>
        <item name="colorSecondary">@color/skoda_electric</item>
        <item name="colorOnSecondary">@color/skoda_emerald_deep</item>
        <item name="colorSurface">@color/skoda_emerald_surface</item>
        <item name="colorOnSurface">@color/skoda_on_dark</item>
        <item name="colorOnSurfaceVariant">@color/skoda_on_dark_muted</item>
        <item name="colorOutline">@color/skoda_emerald_line</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/skoda_emerald_deep</item>
        <item name="android:navigationBarColor">@color/skoda_emerald_deep</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
    </style>

    <style name="ShareLoc.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/skoda_emerald_line</item>
        <item name="cardBackgroundColor">@color/skoda_emerald_surface</item>
    </style>

    <style name="ShareLoc.CardTitle" parent="">
        <item name="android:textColor">@color/skoda_on_dark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ShareLoc.Eyebrow" parent="">
        <item name="android:textColor">@color/skoda_electric</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ShareLoc.MetricTile" parent="">
        <item name="android:background">@drawable/bg_metric_tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ShareLoc.MetricLabel" parent="">
        <item name="android:textColor">@color/skoda_on_dark_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ShareLoc.MetricValue" parent="">
        <item name="android:textColor">@color/skoda_on_dark</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="ShareLoc.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/btn_primary_background</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="rippleColor">@color/skoda_emerald</item>
    </style>

    <style name="ShareLoc.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/btn_secondary_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="rippleColor">@color/skoda_electric_glow</item>
    </style>
</resources>
