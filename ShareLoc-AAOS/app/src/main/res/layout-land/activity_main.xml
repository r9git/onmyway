<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="24dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shareloc_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="@color/skoda_on_dark_muted"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_status_dot_off" />

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/status_off"
                    android:textColor="@color/skoda_on_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="@string/brand_footer"
                android:textColor="@color/skoda_on_dark_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1.15"
                android:orientation="vertical">

                <!-- Hero: cursor + status + speed -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/ShareLoc.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="132dp"
                                android:layout_height="132dp"
                                android:background="@drawable/bg_cursor_ring">

                                <ImageView
                                    android:id="@+id/vehicleCursor"
                                    android:layout_width="96dp"
                                    android:layout_height="96dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.45"
                                    android:contentDescription="@string/vehicle_cursor_description"
                                    android:src="@drawable/ic_vehicle_cursor" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="22dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/ShareLoc.Eyebrow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/current_speed" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="bottom"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/valueSpeed"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:includeFontPadding="false"
                                        android:text="@string/not_available"
                                        android:textColor="@color/white"
                                        android:textSize="64sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginBottom="8dp"
                                        android:text="@string/speed_unit"
                                        android:textColor="@color/skoda_electric"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/statusSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/status_off_detail"
                                    android:textColor="@color/skoda_on_dark_muted"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/privacy_note"
                            android:textColor="@color/skoda_on_dark_muted"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnShareLocation"
                                style="@style/ShareLoc.PrimaryButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1.4"
                                android:text="@string/share_location" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStopSharing"
                                style="@style/ShareLoc.SecondaryButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:enabled="false"
                                android:minHeight="64dp"
                                android:text="@string/stop_sharing" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Live data grid -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/ShareLoc.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/ShareLoc.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/live_data" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                style="@style/ShareLoc.MetricTile"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1">
                                <TextView style="@style/ShareLoc.MetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/latitude" />
                                <TextView android:id="@+id/valueLatitude" style="@style/ShareLoc.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/ShareLoc.MetricTile"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1">
                                <TextView style="@style/ShareLoc.MetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/longitude" />
                                <TextView android:id="@+id/valueLongitude" style="@style/ShareLoc.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/ShareLoc.MetricTile"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_weight="0.8">
                                <TextView style="@style/ShareLoc.MetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/heading" />
                                <TextView android:id="@+id/valueHeading" style="@style/ShareLoc.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                style="@style/ShareLoc.MetricTile"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="0.8">
                                <TextView style="@style/ShareLoc.MetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/accuracy" />
                                <TextView android:id="@+id/valueAccuracy" style="@style/ShareLoc.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/ShareLoc.MetricTile"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1.2">
                                <TextView style="@style/ShareLoc.MetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source" />
                                <TextView android:id="@+id/valueSource" style="@style/ShareLoc.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" android:textSize="15sp" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/ShareLoc.MetricTile"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_weight="0.8">
                                <TextView style="@style/ShareLoc.MetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/last_upload" />
                                <TextView android:id="@+id/valueLastUpload" style="@style/ShareLoc.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/not_available" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Right column: tracking link -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sharePanel"
                style="@style/ShareLoc.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        style="@style/ShareLoc.Eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tracking_link" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/scan_to_follow"
                        android:textColor="@color/skoda_on_dark"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/qrImage"
                        android:layout_width="236dp"
                        android:layout_height="236dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_qr_frame"
                        android:contentDescription="@string/qr_description"
                        android:padding="14dp" />

                    <TextView
                        android:id="@+id/trackingLinkText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:maxLines="3"
                        android:textColor="@color/skoda_on_dark_muted"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSms"
                            style="@style/ShareLoc.SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="@string/send_sms" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShareApp"
                            style="@style/ShareLoc.SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="@string/share_app" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopy"
                            style="@style/ShareLoc.SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="@string/copy_link" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenLink"
                            style="@style/ShareLoc.PrimaryButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:minHeight="54dp"
                            android:textSize="15sp"
                            android:text="@string/open_link" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
